+func (t *tron) confirmOrderHTTP(ctx context.Context, o model.Order) {
+	if o.TradeType == model.TronTrx {
+		trans, err := t.fetchTransactionByID(ctx, o.RefHash)
+		if err != nil {
+			log.Task.Error("Tron HTTP gettransactionbyid", err)
+
+			return
+		}
+		if len(trans.GetRet()) > 0 && trans.GetRet()[0].ContractRet == core.Transaction_Result_SUCCESS {
+			markFinalConfirmed(o)
+		}
+
+		return
+	}
+
+	info, err := t.fetchTransactionInfoByID(ctx, o.RefHash)
+	if err != nil {
+		log.Task.Error("Tron HTTP gettransactioninfobyid", err)
+
+		return
+	}
+	if info.GetReceipt().GetResult() == core.Transaction_Result_SUCCESS {
+		markFinalConfirmed(o)
+	}
+}
